/* =====================================================================
   v61: BLOCKQUOTE FINAL (Sin sobreposiciones, textura y verde fósforo)
   ===================================================================== */

.nt-content blockquote {
  --bq-red: #c8102e;
  --bq-gold: #d4af37;

  position: relative !important;
  margin: 3rem 0 !important;
  
  /* Textura sutil de terminal */
  background-color: var(--bg2) !important;
  background-image: repeating-linear-gradient(
    0deg,
    rgba(255, 255, 255, 0.02) 0px,
    rgba(255, 255, 255, 0.02) 1px,
    transparent 1px,
    transparent 4px
  ) !important;

  /* Doble línea comunista a la izquierda */
  border-left: 2px solid var(--bq-red) !important;
  box-shadow: -2px 0 0 0 var(--bq-gold) !important;
  
  /* Bordes superior e inferior casi invisibles para integrarse */
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-right: none !important;
  
  padding: 2.2rem 1.5rem 1.5rem 1.75rem !important; 
  
  font-family: var(--mono) !important;
  font-size: 0.95em !important;
  line-height: 1.7 !important;
  color: var(--fg) !important; 
  font-style: normal !important;
}

/* Etiqueta flotante en el borde (Ahora en Verde Fósforo) */
.nt-content blockquote::before {
  content: "● // INTERCEPTED_COMMUNICATION" !important;
  position: absolute !important;
  top: -6px !important; 
  left: 1.25rem !important;
  
  /* Fondo de la página para "cortar" el borde superior */
  background: var(--bg) !important; 
  padding: 0 8px !important;
  
  /* Color Verde del sistema */
  color: var(--green) !important; 
  
  font-family: var(--mono) !important;
  font-size: 9px !important;
  font-weight: 800 !important;
  letter-spacing: 0.15em !important;
  z-index: 2 !important;
}

/* Párrafos dentro de la cita */
.nt-content blockquote p {
  margin-bottom: 1em !important;
}
.nt-content blockquote p:last-of-type {
  margin-bottom: 0 !important;
}

/* Ajuste de modo claro */
[data-theme="light"] .nt-content blockquote {
  background-image: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.02) 0px,
    rgba(0, 0, 0, 0.02) 1px,
    transparent 1px,
    transparent 4px
  ) !important;
  border-top-color: rgba(0, 0, 0, 0.08) !important;
  border-bottom-color: rgba(0, 0, 0, 0.08) !important;
}

@media (max-width: 800px) {
  .nt-content blockquote {
    padding: 2rem 1rem 1rem 1.25rem !important;
  }
  .nt-content blockquote::before {
    left: 0.75rem !important;
    font-size: 8px !important;
    letter-spacing: 0.1em !important;
  }
}

/* =====================================================================
   TEST VHS OVERDRIVE (Grano, Tracking y Color Bleeding)
   ===================================================================== */

/* 1. Filtro de color "quemado" */
.nt-vhs-image img {
  filter: contrast(1.15) saturate(1.2) brightness(0.95) !important;
}

/* 2. Grano de película (usando un SVG de ruido) */
.nt-vhs-image {
  position: relative;
  overflow: hidden;
}

.nt-vhs-image::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 3;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.12'/%3E%3C/svg%3E");
  mix-blend-mode: overlay;
}

/* 3. Línea de Tracking (Interferencia) */
.nt-vhs-image .nt-vhs-tracking {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 4;
  background: linear-gradient(
    to bottom,
    transparent 40%,
    rgba(255, 255, 255, 0.15) 50%,
    transparent 60%
  );
  background-size: 100% 200%;
  animation: vhsTracking 6s linear infinite;
  opacity: 0.5;
}

@keyframes vhsTracking {
  0% { background-position: 0 -100%; }
  100% { background-position: 0 100%; }
}



/* =====================================================================
   v65: VHS HOME RECORDING (El VHS de barrio / Los Simpsons grabados)
   ===================================================================== */

/* 1. Imagen: Borrosa, colores sangrados y aberración cromática */
.nt-vhs-image img {
  /* Blur de 0.7px (pierde nitidez), saturación alta, y sombras rojas/azules */
  filter: 
    blur(0.7px) 
    contrast(1.25) 
    saturate(1.4) 
    brightness(0.95) 
    drop-shadow(1.5px 0 0 rgba(255, 0, 0, 0.4)) 
    drop-shadow(-1.5px 0 0 rgba(0, 255, 255, 0.4)) !important;
  animation: none !important; 
}

/* 2. Contenedor: Viñeta CRT + un toque de estática extra */
.nt-vhs-image {
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 0 90px rgba(0,0,0,0.85); /* Esquinas bien oscuras */
}

/* 3. Scanlines y Ruido (Más intensos) */
.nt-vhs-image::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  background: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.35) 0px,
    rgba(0, 0, 0, 0.35) 1px,
    transparent 1px,
    transparent 3px
  );
}

.nt-vhs-image::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 3;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.35'/%3E%3C/svg%3E") !important;
  mix-blend-mode: overlay;
}

/* 4. El Head Switching Noise (La línea de interferencia de abajo) */
.nt-vhs-image .nt-vhs-tracking {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 15%; /* Solo ocupa la parte de abajo */
  pointer-events: none;
  z-index: 4;
  
  /* Simulamos la estática y las líneas de la cinta dañada */
  background: 
    linear-gradient(to bottom, transparent 0%, rgba(255, 255, 255, 0.1) 20%, rgba(0, 0, 0, 0.8) 40%, rgba(255, 255, 255, 0.2) 60%, rgba(0, 0, 0, 0.9) 100%),
    repeating-linear-gradient(90deg, transparent 0, transparent 10px, rgba(255, 255, 255, 0.2) 10px, rgba(255, 255, 255, 0.2) 12px) !important;
  
  mix-blend-mode: overlay;
  animation: none !important;
}

/* 5. Simulamos una "gota" de cinta dañada (línea blanca fija en el medio) */
.nt-vhs-image .nt-vhs-tracking::after {
  content: "";
  position: absolute;
  top: 20%;
  left: 0;
  right: 0;
  height: 2px;
  background: rgba(255, 255, 255, 0.6);
  box-shadow: 0 0 5px rgba(255,255,255,0.8);
  opacity: 0.7;
}

/* =====================================================================
   FINAL POLISH (Los últimos 4 detalles para el 10000/10)
   ===================================================================== */

/* 1. El texto del VHS (REC/PLAY) con aberración cromática sutil */
.nt-vhs-topbar span, 
.nt-vhs-bottombar span {
  text-shadow: 
    0.5px 0 0 rgba(255, 0, 0, 0.6), 
    -0.5px 0 0 rgba(0, 255, 255, 0.6) !important;
}

/* 2. Citas: Más aire arriba y etiqueta perfectamente alineada */
.nt-content blockquote {
  padding-top: 2.5rem !important; /* Un poco más de aire */
}
.nt-content blockquote::before {
  top: -7px !important; /* Un pixel más arriba */
  left: 1rem !important;
}
.nt-content blockquote p:first-of-type {
  margin-top: 0.5rem !important; /* El texto no choca con la etiqueta */
}

/* 3. Notas al pie (Footnotes): Integradas a la estética comunista */



/* 4. Fondo de "señal perdida" en el contenedor de la imagen */
.nt-vhs-image {
  background-color: #050505 !important;
  background-image: 
    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px) !important;
  background-size: 10px 10px !important;
}

/* Ajustes para Modo Claro */
[data-theme="light"] 
[data-theme="light"] .nt-vhs-image {
  background-color: #111 !important;
}


/* =====================================================================
   FOOTNOTES: Estado Original (Limpio, sin CLASSIFIED)
   ===================================================================== */
.nt-content .footnotes {
  margin-top: 4rem;
  padding-top: 2rem;
  border-top: 1px solid var(--line);
  font-size: 13px;
  font-family: var(--mono);
  letter-spacing: 0.01em;
  line-height: 1.6;
}
.nt-content .footnotes::before {
  content: "// FOOTNOTES";
  display: block;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--yellow);
  font-weight: 700;
  margin-bottom: 1rem;
}
.nt-content .footnotes ol {
  padding-left: 0;
  list-style: none;
  counter-reset: footnote;
}
.nt-content .footnotes li {
  padding: 8px 0 8px 40px;
  position: relative;
  border-bottom: 1px dotted var(--line);
  color: var(--dim);
}
.nt-content .footnotes li::before {
  content: "[" counter(footnote) "]";
  counter-increment: footnote;
  position: absolute;
  left: 0;
  color: var(--yellow);
  font-weight: 700;
}
.nt-content .footnotes a {
  color: var(--red);
  text-decoration: underline;
  text-underline-offset: 2px;
  word-break: break-word;
}

/* =====================================================================
   READABILITY MASTER (Tipografía y Ritmo, sin tocar layout)
   ===================================================================== */

/* 1. Ajustes globales del cuerpo de texto */
.nt-content {
  font-size: 19px !important;
  line-height: 1.8 !important;
  letter-spacing: 0.015em !important;
  text-rendering: optimizeLegibility !important;
  -webkit-font-smoothing: antialiased !important;
  /* Suaviza el color del texto para evitar la fatiga visual */
  color: #d4d4d4 !important; 
}

/* 2. El texto en negrita, los títulos y enlaces sí se quedan brillantes */
.nt-content strong, 
.nt-content b, 
.nt-content h2, 
.nt-content h3, 
.nt-content h4 {
  color: var(--fg-strong) !important;
}

/* 3. Espaciado perfecto entre párrafos */
.nt-content p {
  margin-bottom: 1.6em !important;
  text-wrap: pretty !important; /* Evita palabras huérfanas al final de línea */
}

/* 4. Listas con más aire */
.nt-content ul, 
.nt-content ol {
  margin-bottom: 1.6em !important;
  line-height: 1.7 !important;
}

.nt-content li {
  margin-bottom: 0.6em !important;
}

/* 5. Las citas también ganan legibilidad */
.nt-content blockquote {
  line-height: 1.8 !important;
  font-size: 1em !important; /* Igual al texto del cuerpo */
}

/* =====================================================================
   Ajustes específicos para el Modo Claro (Fondo Blanco)
   ===================================================================== */
[data-theme="light"] .nt-content {
  color: #2a2a2a !important; /* Un gris muy oscuro para no lastimar en fondo blanco */
}

/* =====================================================================
   Ajustes para Móvil (Pantallas más pequeñas)
   ===================================================================== */
@media (max-width: 800px) {
  .nt-content {
    font-size: 17px !important;
    line-height: 1.7 !important;
    letter-spacing: 0.01em !important;
  }
  .nt-content p {
    margin-bottom: 1.4em !important;
  }
}






/* =====================================================================
   HERO SERIES PANEL (El equilibrio perfecto)
   ===================================================================== */

/* El panel vuelve al borde normal de 1px */
.nt-hero-series-panel {
  border: 1px solid var(--line) !important;
  box-shadow: none !important;
}

.nt-hero-series-panel .nt-home-panel-header {
  border-bottom: 1px solid var(--line) !important;
  color: var(--dim) !important;
}

/* Los items de las series */
.nt-hero-series-item {
  display: flex;
  align-items: center;
  padding: 12px 14px;
  border-bottom: 1px dotted var(--line);
  border-left: 2px solid transparent;
  font-family: var(--mono);
  text-decoration: none;
  transition: all 0.15s ease-in-out;
}

.nt-hero-series-item:last-child {
  border-bottom: none;
}

/* Hover sutil: solo se enciende el borde y el título */
.nt-hero-series-item:hover {
  background: var(--bg);
  border-left-color: var(--yellow);
}

.nt-series-arrow {
  color: var(--dim);
  font-weight: 800;
  margin-right: 12px;
  font-size: 14px;
  transition: color 0.15s ease;
}

.nt-hero-series-item:hover .nt-series-arrow {
  color: var(--yellow);
}

.nt-series-title {
  color: var(--fg-strong);
  font-size: 16px; /* Tamaño legible pero no gigante */
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  flex: 1;
  transition: color 0.15s ease;
  line-height: 1.2;
}

.nt-hero-series-item:hover .nt-series-title {
  color: var(--yellow);
}

.nt-series-count {
  color: var(--dim);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  transition: color 0.15s ease;
}

.nt-hero-series-item:hover .nt-series-count {
  color: var(--yellow);
}

@media (max-width: 800px) {
  .nt-series-title { font-size: 14px; }
  .nt-series-arrow { font-size: 12px; }
  .nt-hero-series-item { padding: 10px 10px; }
}

/* =====================================================================
   ANCHOR LINKS Y BOTÓN DE COPIAR
   ===================================================================== */

/* 1. Anchor Link (#) */


/* Mostrar solo al pasar el mouse por el título */


/* El pre pierde su margen para que el wrapper lo controle */
.nt-code-wrapper pre {
  margin: 0 !important;
}

.nt-copy-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: var(--bg2);
  border: 1px solid var(--line);
  color: var(--dim);
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  padding: 4px 8px;
  cursor: pointer;
  z-index: 10;
  transition: all 0.2s ease;
}

.nt-copy-btn:hover {
  color: var(--yellow);
  border-color: var(--yellow);
  background: var(--bg);
}

/* Ocultar el botón en móvil (para no tapar el código) */
@media (max-width: 800px) {
  .nt-copy-btn { display: none; }
   /* En móvil no hay hover, así que mostramos el # siempre */
}



/* =====================================================================
   UNIFIED SHARE BUTTON (Igual arriba y abajo)
   ===================================================================== */











.nt-share-icon {
  font-size: 14px;
  font-weight: 900;
}

/* Alineación específica para el de arriba */


/* Ajustes responsive */
@media (max-width: 800px) {
  
  
  
}

/* =====================================================================
   CLEAR SHARE BUTTON (Solo arriba, texto dinámico)
   ===================================================================== */

.nt-share-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 24px;
}







.nt-share-icon {
  font-size: 14px;
  font-weight: 900;
}

@media (max-width: 800px) {
  .nt-share-row {
    justify-content: stretch;
    margin-top: 20px;
  }
  
}

/* =====================================================================
   TACTICAL SHARE BUTTON (Estilo Terminal de los 90)
   ===================================================================== */

.nt-share-inline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: 1px solid var(--yellow);
  color: var(--yellow);
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 6px 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  opacity: 1 !important;
}

.nt-share-inline:hover {
  background: var(--yellow);
  color: var(--bg);
  box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
}

.nt-share-inline.copied {
  border-color: var(--green);
  color: var(--green);
  background: transparent;
  box-shadow: none;
}

.nt-share-icon {
  font-size: 13px;
  font-weight: 900;
}

@media (max-width: 800px) {
  .nt-share-row {
    justify-content: stretch;
    margin-top: 20px;
  }
  .nt-share-inline {
    width: 100%;
    justify-content: center;
    padding: 12px;
    font-size: 11px;
  }
}

/* =====================================================================
   MOBILE LEGIBILITY (Lectura perfecta en Celular)
   ===================================================================== */

@media (max-width: 800px) {
  /* Márgenes laterales (20px = el "safe area" del pulgar) */
  .nt-post-body {
    padding-left: 20px !important;
    padding-right: 20px !important;
    padding-top: 32px !important;
  }

  /* Tipografía para pantallas pequeñas */
  .nt-content {
    font-size: 18px !important; /* Letra más grande para leer sin forzar la vista */
    line-height: 1.8 !important;
    letter-spacing: 0.01em !important;
    hyphens: auto !important; /* Corta las palabras largas con guion */
    -webkit-hyphens: auto !important;
  }

  /* Párrafos con más aire */
  .nt-content p {
    margin-bottom: 1.6em !important;
    text-wrap: pretty !important; 
  }

  /* Títulos ajustados al ancho del celular */
  .nt-title, .nt-post-title {
    font-size: clamp(26px, 8vw, 36px) !important;
    line-height: 1.1 !important;
  }

  /* Headers (H2/H3) con un poquito más de margen */
  .nt-content h2, .nt-content h3 {
    margin-top: 2.5rem !important;
    word-break: break-word !important;
  }

  /* El botón de compartir un poco más grande para el dedo */
  .nt-share-inline {
    padding: 14px 20px !important;
    font-size: 12px !important;
  }

  /* Imágenes VHS: Ajustar para que el desenfoque no maree en pantallas chicas */
  .nt-vhs-image img {
    filter: contrast(1.2) saturate(1.3) sepia(0.2) !important; /* Sin blur en celular */
  }

  /* Ajustar el panel de series en el Hero */
  .nt-hero-series-item {
    padding: 14px 10px !important;
  }
  .nt-series-title {
    font-size: 16px !important;
  }
}

/* Pantallas muy pequeñas (iPhone SE, etc.) */
@media (max-width: 380px) {
  .nt-content {
    font-size: 17px !important;
  }
  .nt-post-body {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }
}
