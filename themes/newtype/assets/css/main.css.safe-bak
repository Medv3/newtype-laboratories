}

/* =====================================================================
   v60: CITAS INTEGRADAS (Textura, punto verde y suavizado)
   ===================================================================== */



/* Etiqueta integrada con punto verde */


/* El punto verde específico usando un truco de color */

/* Ajustamos el padding para que el punto no choque */





/* Modo claro */
[data-theme="light"] 

