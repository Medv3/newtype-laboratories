/* =====================================================================
   v42: VHS MONITOR (Restaurado exactamente como estaba)
   ===================================================================== */
.nt-surveillance {
  margin: 3rem 0 !important;
  display: block;
}
.nt-vhs-frame {
  border: 1px solid var(--line);
  background: #000;
  padding: 0;
  border-radius: 0;
  box-shadow: none;
}
.nt-vhs-topbar, .nt-vhs-bottombar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: #000;
}
.nt-vhs-topbar { border-bottom: 1px solid var(--line); }
.nt-vhs-bottombar { border-top: 1px solid var(--line); }
.nt-rec { color: var(--red); }
.nt-rec-dot { animation: blink 2s steps(1) infinite; margin-right: 4px; }
.nt-cam-id { color: var(--dim); font-weight: 400; }
.nt-cam-play { color: var(--green); }
.nt-cam-time { color: var(--yellow); }
.nt-vhs-image { position: relative; display: block; background: #000; }
.nt-vhs-image img { display: block; width: 100%; border: none !important; filter: contrast(1.05); }
.nt-vhs-image::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.15) 0px, rgba(0, 0, 0, 0.15) 1px, transparent 1px, transparent 3px);
}
.nt-surveillance figcaption {
  padding: 10px 0 0 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  text-align: right;
  color: var(--dim);
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}


/* =====================================================================
   v57: HEADERS AJUSTADOS Y CITAS BICOLOR (Toque Comunista)
   ===================================================================== */

.nt-content {  }

/* --- H2: Línea inferior verde ajustada al texto --- */
.nt-content h2 {
    font-family: var(--mono) !important; 
  font-size: clamp(20px, 3vw, 24px) !important;
  font-weight: 700 !important; 
  text-transform: uppercase !important;
  color: var(--fg-strong) !important; 
  
  margin: 4rem 0 2rem 0 !important;
  padding: 0 2rem 12px 0 !important; /* 2rem a la derecha para que la línea se extienda "un poquito más" */
  
  /* fit-content hace que el borde no llegue al final de la pantalla */
  display: flex !important;
  width: fit-content !important;
  
  border-top: none !important; 
  border-bottom: 1px solid var(--green) !important; 
  letter-spacing: -0.01em !important;
}

.nt-content h2::before {
  content: ">> " !important;
  color: var(--red) !important; 
  margin-right: 8px !important; 
  font-weight: 900 !important;
}

.nt-content h2::after {
  display: none !important; /* Sin línea derecha */
}

/* --- H3: Línea inferior amarilla ajustada al texto --- */
.nt-content h3 {
    font-family: var(--mono) !important; 
  font-size: clamp(16px, 2vw, 18px) !important;
  font-weight: 700 !important; 
  text-transform: none !important;
  color: var(--yellow) !important; 
  
  margin: 3rem 0 1rem 0 !important;
  padding: 0 2rem 6px 0 !important;
  
  display: flex !important;
  width: fit-content !important;
  
  background: transparent !important;
  border: none !important;
  border-bottom: 1px dotted var(--yellow) !important; /* Línea amarilla restaurada */
}

.nt-content h3::before {
  content: "> " !important;
  color: var(--dim) !important; 
  margin-right: 8px !important; 
  font-weight: 400 !important;
}

/* Excepción About */
.nt-content.nt-about > h2:first-of-type {
   
  border: none !important; 
  padding: 0 !important; 
  margin-bottom: 1rem !important;
  display: block !important; /* Volver a block en About */
  width: 100% !important;
}
.nt-content.nt-about > h2:first-of-type::before {
  content: "" !important; 
  display: none !important;
}







/* Asegurar que los párrafos dentro de la cita fluyan bien */



